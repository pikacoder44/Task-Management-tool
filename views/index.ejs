<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900">
      <div class="form text-white p-10">
        <form action="/create" method="post">
          <input
            class="block px-3 rounded-md outline-none w-full py-2 bg-zinc-800"
            type="text"
            placeholder="title goes here"
            name="title"
          />
          <textarea
            class="block px-3 mt-2 py-2 rounded-md outline-none w-full resize-none bg-zinc-800"
            name="details"
            placeholder="Write your task details here"
          ></textarea>
          <input
            class="mt-2 bg-blue-900 rounded-md p-2"
            type="submit"
            value="Create Task"
          />
        </form>
      </div>
      <div class="tasks flex gap-3 flex-wrap p-10">
        <% if(files.length > 0){ %> <% files.forEach(function(val){ %>
        <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
          <h1 class="text-white text-3xl tracking-tighter">
            <%= val.split(".txt").join("") %>
          </h1>

          <div class="flex justify-between items-center mt-3 w-full rounded-md">
            <a class="text-blue-500 inline-block" href="/files/<%= val %>"
              >Read more.</a
            >
            <a class="text-zinc-500" href="/edit/<%= val %>">
              <svg
                class="h-6 w-6 hover:text-blue-200 mt-0 text-white-500"
                <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                />
                <path
                  d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                />
              </svg>
            </a>
          </div>
        </div>
        <% }) %> <% } else { %>
        <h3 class="text-zinc-600">No tasks yet.</h3>
        <% } %>
      </div>
    </div>
  </body>
</html>
